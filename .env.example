# Copia este archivo a .env y pon tus valores reales. Nunca subas .env al repo.

# --- API keys (backend only) ---
# Solo hace falta la key de los proveedores activos (ver abajo).
ANTHROPIC_API_KEY=
# Gratis: https://console.groq.com/keys
GROQ_API_KEY=
# Solo si usas openai_whisper u openai_tts
OPENAI_API_KEY=

# --- Active providers ---
# groq_whisper (free tier) | openai_whisper
STT_PROVIDER=groq_whisper
LLM_PROVIDER=anthropic_claude
# kokoro (free, local, natural) | piper (free, local, lighter but robotic) | openai_tts
TTS_PROVIDER=kokoro

# --- STT ---
# Groq: whisper-large-v3 (understands accents better) | whisper-large-v3-turbo (faster)
GROQ_STT_MODEL=whisper-large-v3
# OpenAI: whisper-1 | gpt-4o-mini-transcribe | gpt-4o-transcribe
STT_MODEL=whisper-1

# --- LLM ---
# claude-haiku-5-5 (fast, cheap) | claude-sonnet-5-5 | claude-opus-5-5 (best quality, slower)
LLM_MODEL=claude-haiku-5-5
# low | medium | high  (low = lower latency, which matters for voice)
LLM_EFFORT=low
LLM_MAX_TOKENS=2048

# --- TTS ---
# Kokoro: model files are downloaded automatically into backend/voices/ on first start.
# Voices: af_heart, af_bella, af_nicole, af_sarah (US female) | am_michael, am_adam (US male)
#         bf_emma, bf_isabella (UK female) | bm_george, bm_lewis (UK male)
# List: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
KOKORO_VOICE=af_heart
# Voice for the Spanish parts (pronounced as Latin American Spanish).
# Empty = same voice as above (one "person", with a gringo accent) | ef_dora | em_alex
KOKORO_VOICE_ES=
# kokoro-v1.0.int8.onnx (88 MB, ~280 MB RAM) | kokoro-v1.0.onnx (310 MB, ~520 MB RAM)
KOKORO_MODEL_FILE=kokoro-v1.0.int8.onnx
# Piper: downloaded automatically (~60 MB) into backend/voices/ on first start.
# Other voices: en_US-amy-medium, en_US-hfc_female-medium, en_GB-alba-medium...
# Catalog: https://huggingface.co/rhasspy/piper-voices
PIPER_VOICE=en_US-lessac-medium
# OpenAI TTS: gpt-4o-mini-tts (more natural, accepts style instructions) | tts-1 | tts-1-hd
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova

# --- App ---
# Nimbo greets you by name (and speech recognition writes it better)
USER_NAME=
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# --- Database (used starting in Phase 4) ---
POSTGRES_USER=nimbo
POSTGRES_PASSWORD=nimbo
POSTGRES_DB=nimbo
DATABASE_URL=postgresql+asyncpg://nimbo:nimbo@localhost:5432/nimbo
