# Copia este archivo a .env y pon tus valores reales. Nunca subas .env al repo.

# --- API keys (backend only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Active providers ---
STT_PROVIDER=openai_whisper
LLM_PROVIDER=anthropic_claude
TTS_PROVIDER=openai_tts

# --- STT ---
# whisper-1 | gpt-4o-mini-transcribe | gpt-4o-transcribe
STT_MODEL=whisper-1

# --- LLM ---
# claude-haiku-5-5 (fast, cheap) | claude-sonnet-5-5 | claude-opus-5-5 (best quality, slower)
LLM_MODEL=claude-haiku-5-5
# low | medium | high  (low = lower latency, which matters for voice)
LLM_EFFORT=low
LLM_MAX_TOKENS=2048

# --- TTS ---
# gpt-4o-mini-tts (more natural, accepts style instructions) | tts-1 | tts-1-hd
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova

# --- App ---
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# --- Database (used starting in Phase 4) ---
POSTGRES_USER=nimbo
POSTGRES_PASSWORD=nimbo
POSTGRES_DB=nimbo
DATABASE_URL=postgresql+asyncpg://nimbo:nimbo@localhost:5432/nimbo
